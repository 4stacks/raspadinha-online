# Compose files are evaluated relative to deploy/supabase/docker-compose.yml.
COMPOSE_FILE=deploy/supabase/docker-compose.yml:compose.yaml

# Bind published ports to loopback by default. Put a TLS reverse proxy in front
# and deliberately adjust BIND_IP for public access.
BIND_IP=127.0.0.1
WEB_PORT=3000
API_GW_HTTP_PORT=8000
POSTGRES_HOST_PORT=54322
POOLER_PROXY_PORT_TRANSACTION=6543

# Public URLs used by browsers and Supabase Auth. For production, set these to
# the HTTPS URLs served by your reverse proxy.
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000

# Private in-network URL used only by the Next.js server container.
SUPABASE_INTERNAL_URL=http://api-gw:8000

# Initialized with cryptographically random values by scripts/init-env.mjs.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
DASHBOARD_PASSWORD=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
LOGFLARE_PUBLIC_ACCESS_TOKEN=
LOGFLARE_PRIVATE_ACCESS_TOKEN=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
MINIO_ROOT_PASSWORD=

# The public anon JWT is embedded in the browser bundle and is not a secret.
# The service role JWT, database password and dashboard password are secrets.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# Supabase keys and local service settings.
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POOLER_TENANT_ID=sorte-de-casa
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5
STUDIO_DEFAULT_ORGANIZATION=Sorte de Casa
STUDIO_DEFAULT_PROJECT=Promocoes
DASHBOARD_USERNAME=supabase
OPENAI_API_KEY=
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
JWT_EXPIRY=3600
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Sorte de Casa
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
GLOBAL_S3_BUCKET=stub
REGION=local
STORAGE_TENANT_ID=local
FUNCTIONS_VERIFY_JWT=false
IMGPROXY_AUTO_WEBP=true
